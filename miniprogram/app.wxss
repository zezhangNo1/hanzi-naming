/**
 * app.wxss — 全局样式：色板变量 + 衬线字体定义
 * 配色（2026-11 新生儿风改版）：奶白暖底 / 暖墨文字 / 珊瑚点缀
 */
page {
  /* ===== 色板变量 ===== */
  --paper: #FDF9F1;          /* 奶白：全局底色 */
  --paper-deep: #F5EEDF;     /* 奶白加深：卡片分隔/阴影底 */
  --ink: #33302B;            /* 暖墨：主文字 */
  --ink-60: rgba(51, 48, 43, 0.6);   /* 暖墨 60%：次级文字 */
  --ink-30: rgba(51, 48, 43, 0.3);   /* 暖墨 30%：占位/描边 */
  --cinnabar: #D96C55;       /* 珊瑚：强调、按钮、收藏标记 */
  --cinnabar-soft: rgba(217, 108, 85, 0.08); /* 珊瑚浅底 */

  /* ===== 字体定义 ===== */
  --font-serif: "Songti SC", "STSong", "SimSun", "Noto Serif SC", serif; /* 名字衬线字体 */
  --font-sans: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; /* 正文无衬线 */

  background-color: var(--paper);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用工具类 ===== */

/* 名字专用衬线字体 */
.font-serif {
  font-family: var(--font-serif);
}

/* 珊瑚强调色 */
.color-cinnabar {
  color: var(--cinnabar);
}

/* 页面安全内边距容器 */
.page-pad {
  padding: 32rpx;
  box-sizing: border-box;
}

/* 占位卡片样式 */
.placeholder-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(51, 48, 43, 0.05);
}
