/* chars 页样式：宣纸底 + 墨色衬线大字 + 朱砂点缀 */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: var(--paper, #FDF9F1);
}

/* 状态盒 */
.state-box {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-title { font-size: 36rpx; color: var(--ink, #33302B); }
.state-sub { margin-top: 16rpx; font-size: 26rpx; color: rgba(28, 28, 28, 0.5); }
.state-btn { margin-top: 48rpx; width: 320rpx; }
.btn {
  border-radius: 20rpx;
  background: var(--cinnabar, #D96C55);
  color: #FFFFFF;
  font-size: 30rpx;
}
.btn::after { border: none; }

/* 字库版本标识行 */
.board-line {
  display: block;
  margin: 4rpx 4rpx 16rpx;
  font-size: 22rpx;
  color: rgba(51, 48, 43, 0.45);
}

/* 气质分组横滑 chips */
.group-scroll {
  width: 100%;
  white-space: nowrap;
}
.group-row {
  display: inline-flex;
  padding: 4rpx 0 8rpx;
}
.group-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(51, 48, 43, 0.05);
}
.group-chip--on {
  background: var(--cinnabar, #D96C55);
}
.group-label {
  font-size: 26rpx;
  color: var(--ink, #33302B);
}
.group-chip--on .group-label { color: #FFFFFF; }
.group-count {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(28, 28, 28, 0.4);
}
.group-chip--on .group-count { color: rgba(255, 255, 255, 0.75); }

/* 热度筛选 */
.freq-row {
  margin-top: 16rpx;
  display: flex;
}
.freq-chip {
  margin-right: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(51, 48, 43, 0.12);
  font-size: 24rpx;
  color: rgba(28, 28, 28, 0.6);
}
.freq-chip--on {
  border-color: var(--cinnabar, #D96C55);
  color: var(--cinnabar, #D96C55);
  background: rgba(176, 58, 46, 0.06);
}

.total-line {
  display: block;
  margin: 20rpx 4rpx 16rpx;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.45);
}

/* 字卡网格（3 列） */
.char-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.char-card {
  width: 218rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(51, 48, 43, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.char-card--tap { background: #FDFBF5; }
.char-head {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
}
.char-glyph {
  font-size: 72rpx;
  color: var(--ink, #33302B);
  line-height: 1.2;
}
.char-gender {
  position: absolute;
  right: 0;
  top: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
}
.char-gender--m { background: rgba(58, 110, 176, 0.1); color: #3A6EB0; }
.char-gender--f { background: rgba(176, 58, 90, 0.1); color: #B03A5A; }
.char-gender--n { background: rgba(28, 28, 28, 0.06); color: rgba(28, 28, 28, 0.55); }
.char-pinyin {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(28, 28, 28, 0.55);
}
.char-meaning {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(28, 28, 28, 0.65);
  text-align: center;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.disclaimer {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.4);
  line-height: 1.6;
}

/* 字详情弹层 */
.detail-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(28, 28, 28, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.detail-card {
  width: 600rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(51, 48, 43, 0.12);
}
.detail-head {
  display: flex;
  align-items: center;
}
.detail-glyph {
  font-size: 96rpx;
  color: var(--ink, #33302B);
  line-height: 1.1;
}
.detail-meta {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}
.detail-pinyin {
  font-size: 32rpx;
  color: rgba(28, 28, 28, 0.7);
}
.detail-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.5);
}
.detail-line {
  margin-top: 24rpx;
  display: flex;
}
.detail-label {
  flex: 0 0 88rpx;
  font-size: 24rpx;
  color: var(--cinnabar, #D96C55);
}
.detail-value {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(28, 28, 28, 0.8);
}
.detail-close {
  margin-top: 36rpx;
  border-radius: 20rpx;
  background: var(--paper, #FDF9F1);
  color: var(--ink, #33302B);
  font-size: 28rpx;
}
.detail-close::after { border: none; }
