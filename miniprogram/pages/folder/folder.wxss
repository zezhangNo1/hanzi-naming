/* folder 页样式：宣纸底 + 墨色衬线名 + 朱砂点缀（对齐 result 页卡片风格） */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: var(--paper, #F7F4EC);
}

/* 状态盒（加载/失败/空态） */
.state-box {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-title { font-size: 36rpx; color: var(--ink, #1C1C1C); }
.state-sub { margin-top: 16rpx; font-size: 26rpx; color: rgba(28, 28, 28, 0.5); }
.state-btn { margin-top: 48rpx; width: 320rpx; }

.btn-row {
  margin-top: 48rpx;
  display: flex;
  gap: 24rpx;
}
.btn {
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink, #1C1C1C);
  font-size: 30rpx;
}
.btn::after { border: none; }
.btn--primary {
  background: var(--cinnabar, #B03A2E);
  color: #FFFFFF;
}

/* 收藏计数行（含 AI 帮选入口） */
.count-line {
  margin: 8rpx 0 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.count-text {
  font-size: 24rpx;
  color: rgba(28, 28, 28, 0.5);
}
.ai-btn {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: var(--cinnabar, #B03A2E);
  color: #FFFFFF;
  font-size: 24rpx;
}
.ai-btn--busy { opacity: 0.6; }

/* AI 帮选结果面板 */
.pick-panel {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(28, 28, 28, 0.05);
}
.pick-head {
  display: flex;
  align-items: center;
}
.pick-title {
  font-size: 32rpx;
  color: var(--ink, #1C1C1C);
}
.pick-mode {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(176, 58, 46, 0.08);
  color: var(--cinnabar, #B03A2E);
  font-size: 20rpx;
}
.pick-close {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.4);
}
.pick-aigc {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(28, 28, 28, 0.4);
}
.pick-top {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: rgba(176, 58, 46, 0.05);
  display: flex;
  align-items: flex-start;
}
.pick-rank {
  flex: 0 0 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--cinnabar, #B03A2E);
  color: #FFFFFF;
  font-size: 24rpx;
  text-align: center;
  line-height: 44rpx;
}
.pick-body {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.pick-name {
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--ink, #1C1C1C);
}
.pick-reason {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(28, 28, 28, 0.7);
}
.pick-comment {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(28, 28, 28, 0.06);
  display: flex;
}
.pick-cname {
  flex: 0 0 160rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--ink, #1C1C1C);
}
.pick-ctext {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(28, 28, 28, 0.75);
}

/* 收藏卡（对齐 result 页候选卡） */
.candidate {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(28, 28, 28, 0.05);
}
.candidate--tap { background: #FDFBF5; }
.candidate-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.candidate-name {
  font-size: 64rpx;
  letter-spacing: 12rpx;
  color: var(--ink, #1C1C1C);
}
.candidate-pinyin {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(28, 28, 28, 0.55);
}
.candidate-tags {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
.tag {
  margin: 0 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 28, 0.05);
  color: rgba(28, 28, 28, 0.65);
  font-size: 22rpx;
}
.candidate-meaning {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(28, 28, 28, 0.8);
}

/* 一句话备注（朱砂浅底） */
.candidate-note {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(176, 58, 46, 0.08);
  color: var(--cinnabar, #B03A2E);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 卡片底部操作行 */
.candidate-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(28, 28, 28, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.foot-hint {
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.4);
}
.foot-remove {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(28, 28, 28, 0.2);
  color: rgba(28, 28, 28, 0.6);
  font-size: 24rpx;
}

.disclaimer {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.4);
  line-height: 1.6;
}
