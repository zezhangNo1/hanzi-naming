/* result 页样式：宣纸底 + 墨色衬线名 + 朱砂点缀（对齐原型屏02） */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: var(--paper, #F7F4EC);
}

/* 降级横幅 */
.degraded-banner {
  margin-bottom: 20rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(176, 58, 46, 0.08);
  color: var(--cinnabar, #B03A2E);
  font-size: 24rpx;
}

/* 状态盒（加载/失败） */
.state-box {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-title { font-size: 36rpx; color: var(--ink, #1C1C1C); }
.state-sub { margin-top: 16rpx; font-size: 26rpx; color: rgba(28, 28, 28, 0.5); }

/* 候选卡 */
.candidate {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(28, 28, 28, 0.05);
}
.candidate-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.candidate-name {
  font-size: 64rpx;
  letter-spacing: 12rpx;
  color: var(--ink, #1C1C1C);
}
.candidate-pinyin {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(28, 28, 28, 0.55);
}
.candidate-tags {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
.tag {
  margin: 0 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 28, 0.05);
  color: rgba(28, 28, 28, 0.65);
  font-size: 22rpx;
}
.candidate-meaning {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(28, 28, 28, 0.8);
}

/* 底部 */
.footer { margin-top: 40rpx; display: flex; flex-direction: column; }
.quota {
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(28, 28, 28, 0.5);
}

.btn {
  margin: 0 0 20rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink, #1C1C1C);
  font-size: 30rpx;
}
.btn--primary {
  background: var(--cinnabar, #B03A2E);
  color: #FFFFFF;
}
.btn--block { width: 100%; }
.btn--disabled { opacity: 0.6; }

.btn::after { border: none; }

.disclaimer {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.4);
  line-height: 1.6;
}
