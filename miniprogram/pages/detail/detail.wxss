/* detail 页样式：命名检测报告（宣纸底/墨色/朱砂点缀，对齐结果页规范） */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: var(--paper, #FDF9F1);
}

/* 状态盒（加载/失败） */
.state-box {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-title { font-size: 36rpx; color: var(--ink, #33302B); }
.state-sub { margin-top: 16rpx; font-size: 26rpx; color: var(--ink-60, rgba(28, 28, 28, 0.5)); }
.btn-row {
  margin-top: 48rpx;
  display: flex;
  gap: 24rpx;
}

/* 标题区 */
.report-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.report-title {
  font-size: 40rpx;
  letter-spacing: 8rpx;
  color: var(--ink, #33302B);
}
.report-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-30, rgba(28, 28, 28, 0.4));
}

/* 名字卡 */
.name-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(51, 48, 43, 0.05);
}
.name {
  font-size: 72rpx;
  letter-spacing: 16rpx;
  color: var(--ink, #33302B);
}
.pinyin {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(28, 28, 28, 0.55);
}
.name-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}
.tag {
  margin: 0 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 28, 0.05);
  color: rgba(28, 28, 28, 0.65);
  font-size: 22rpx;
}
.name-meaning {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(28, 28, 28, 0.8);
  text-align: center;
}

/* 六维 section */
.section {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(51, 48, 43, 0.05);
}
.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-bar {
  width: 8rpx;
  height: 30rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
  background: var(--cinnabar, #D96C55);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink, #33302B);
}

/* 字义逐字卡 */
.char-cards {
  display: flex;
  gap: 16rpx;
}
.char-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  background: var(--paper, #FDF9F1);
}
.char-char-row {
  display: flex;
  align-items: baseline;
}
.char-char {
  font-size: 56rpx;
  color: var(--ink, #33302B);
}
.char-surname-mark {
  margin-left: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(28, 28, 28, 0.06);
  font-size: 18rpx;
  color: var(--ink-60, rgba(28, 28, 28, 0.6));
}
.char-strokes {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-60, rgba(28, 28, 28, 0.6));
}
.char-meaning {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
  color: rgba(28, 28, 28, 0.8);
}

/* 键值行（笔画/重名度） */
.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}
.kv-label {
  font-size: 26rpx;
  color: var(--ink-60, rgba(28, 28, 28, 0.6));
}
.kv-value {
  font-size: 26rpx;
  color: var(--ink, #33302B);
}
.kv-value--high { color: var(--cinnabar, #D96C55); }
.kv-value--low { color: #3E7C4F; }
.dup-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-60, rgba(28, 28, 28, 0.6));
}

/* 操作区 */
.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
}
.btn {
  margin: 0 0 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--ink, #33302B);
  font-size: 30rpx;
}
.btn--primary {
  background: var(--cinnabar, #D96C55);
  color: #FFFFFF;
}
.btn--block { width: 100%; }
.btn--disabled { opacity: 0.6; }
.btn::after { border: none; }

.disclaimer {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(28, 28, 28, 0.4);
  line-height: 1.6;
}
