/* report-feedback 样式：弱化入口（描边胶囊），提交后置灰 */
.rf {
  display: flex;
  justify-content: center;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(28, 28, 28, 0.12);
}

.rf--tap {
  opacity: 0.75;
}

.rf--done {
  border-color: rgba(28, 28, 28, 0.06);
  background: rgba(28, 28, 28, 0.03);
}

.rf-text {
  font-size: 26rpx;
  color: var(--ink-60, rgba(28, 28, 28, 0.6));
}

.rf--done .rf-text {
  color: var(--ink-30, rgba(28, 28, 28, 0.3));
}
